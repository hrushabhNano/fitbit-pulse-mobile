<?xml version="1.0" encoding="utf-8"?>
<!-- A glow widget is one bitmap (GlowWidgets.kt): RemoteViews can't host custom views, and launchers drop font resources. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/glow_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/glow_widget_background"
  android:clipToOutline="true">
  <ImageView
    android:id="@+id/glow_art"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="fitXY"
    android:importantForAccessibility="yes" />
</FrameLayout>
